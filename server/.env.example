# ============================================
# KIDORA Backend Environment Configuration
# ============================================

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kidora_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kidora_db

# Security & JWT Secrets
JWT_SECRET=kidora_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# Default Parent PIN for Demo Seed (1234)
DEFAULT_PARENT_PIN=1234

# Disk persistence (JSON autosave) — optional overrides
# DATA_FILE=/var/www/kidora/server/data/store.json
# AUTOSAVE_MS=15000
