# ============================================
# KIDORA Backend — konfigurasi
# Salin fail ini jadi `.env` dan isi nilai sebenar.
# JANGAN commit `.env` ke GitHub.
# ============================================

# URL awam aplikasi. Guna HTTPS dalam production.
BASE_URL=https://kidora.com.my

# ---- Bayarcash Payment Gateway (https://bayar.cash) ----
# Dapatkan PAT & Secret Key dari: Console → Profile → Integration.
# Dapatkan Portal Key dari: Console → Portal → pilih portal anda.
# Sandbox console: https://console.bayarcash-sandbox.com
# Production console: https://console.bayar.cash
BAYARCASH_PAT=
BAYARCASH_SECRET_KEY=
BAYARCASH_PORTAL_KEY=

# true = guna sandbox (testing, tiada bayaran sebenar).
# Tukar kepada false bila sedia untuk terima bayaran sebenar.
BAYARCASH_SANDBOX=true

# Kunci admin — untuk panel /admin-kidora (alat sokongan/fallback manual sahaja).
# Guna phrase rawak yang panjang, cth: openssl rand -hex 24
ADMIN_KEY=

# Port backend
PORT=5000
