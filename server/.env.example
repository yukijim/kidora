# ============================================
# KIDORA Backend — konfigurasi
# Salin fail ini jadi `.env` dan isi nilai sebenar.
# JANGAN commit `.env` ke GitHub.
# ============================================

# API Key BizApp Pay (dapat di: https://www.bizappay.my/merchant → Settings > Profile)
BIZAPPAY_API_KEY=

# (Pilihan) Kod kategori bil BizApp Pay.
# Kalau kosong, sistem guna kategori pertama akaun anda (biasanya "General").
BIZAPPAY_CATEGORY=

# URL awam aplikasi (untuk callback & return URL). Guna HTTPS dalam production.
BASE_URL=https://kidora.com.my

# (Pilihan) Kunci admin untuk jana kod akses secara manual (fallback bayaran bank/WhatsApp).
# Kalau kosong, endpoint admin dimatikan.
ADMIN_KEY=

# Port backend
PORT=5000
