# Set as runtime environment variables in Coolify, or copy to
# /var/www/kidora/server/.env for PM2. Never commit actual secrets.
NODE_ENV=production
PORT=5000
BASE_URL=https://kidora.com.my

# Keys must belong to the same production account and portal.
BAYARCASH_PAT=
BAYARCASH_SECRET_KEY=
BAYARCASH_PORTAL_KEY=
BAYARCASH_SANDBOX=false

ADMIN_KEY=
# Mount persistent storage for orders and access codes.
# DATA_DIR=/var/www/kidora/server/data
