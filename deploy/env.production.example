# ============================================
# KIDORA Backend — Production Environment
# Salin ke /var/www/kidora/server/.env di VPS,
# kemudian isi JWT_SECRET dengan rentetan rawak yang panjang.
# ============================================

NODE_ENV=production
PORT=5000

# Frontend URL (untuk CORS)
CLIENT_URL=https://kidora.com.my

# JWT — WAJIB tukar kepada rentetan rawak (contoh: hasil `openssl rand -hex 32`)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# PIN parent lalai (demo)
DEFAULT_PARENT_PIN=1234

# Disk persistence (default sudah betul; buang komen jika nak override)
# DATA_FILE=/var/www/kidora/server/data/store.json
# AUTOSAVE_MS=15000
